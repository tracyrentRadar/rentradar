# Copy to .env and replace every change-me value: cp .env.example .env
# .env is gitignored. It is read by docker compose (the Mongo container) and by
# the Spring dev profile (the app), so both always agree on the credentials.
#
# Format: plain KEY=value lines. No quotes, no spaces around =, no inline
# comments, no backslashes. Changing a password after the first start needs
# `docker compose down -v` so the init script runs again on a fresh volume.

# MongoDB superuser, used only by the container to initialise itself
MONGO_ROOT_USERNAME=rentradar_root
MONGO_ROOT_PASSWORD=change-me-root

# Application user, scoped to the application database
MONGO_APP_DATABASE=rentradar
MONGO_APP_USERNAME=rentradar_app
MONGO_APP_PASSWORD=change-me-app

# Host port for MongoDB, bound to 127.0.0.1 only
MONGO_PORT=27017
