<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resultScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_32">

        <!-- Principle 3: cached content is labelled, above everything else.
             Full bleed strip, no card, no shadow. -->
        <LinearLayout
            android:id="@+id/cachedBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSecondaryContainer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_12"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/cachedText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSecondaryContainer"
                tools:text="Saved estimate from 3 October, 14:12. You are offline, so this has not been rechecked." />
        </LinearLayout>

        <!-- The estimate. Sits straight on the page. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_20"
            android:paddingBottom="@dimen/space_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_estimate_heading"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Principle 1: the interval has equal weight to the estimate.
                 Same size, same colour, one line, no small print. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/estimateLower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="3,834" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_8"
                    android:text="@string/result_range_separator"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/estimateUpper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="4,879" />
            </LinearLayout>

            <TextView
                android:id="@+id/estimateIntervalLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center_horizontal"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Likely monthly rent, 9 times in 10 (GHS)" />

            <!-- Band is the interval, notch is the estimate, pin is the
                 asking price. Positions set in ResultFragment. -->
            <FrameLayout
                android:id="@+id/rangeBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/range_bar_height"
                android:layout_marginTop="@dimen/space_16">

                <View
                    android:id="@+id/rangeTrack"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/range_track_height"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_range_track" />

                <View
                    android:id="@+id/rangeBand"
                    android:layout_width="120dp"
                    android:layout_height="@dimen/range_track_height"
                    android:layout_gravity="center_vertical|start"
                    android:background="@drawable/bg_range_band" />

                <View
                    android:id="@+id/rangePoint"
                    android:layout_width="@dimen/range_notch_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="@drawable/bg_range_point" />

                <View
                    android:id="@+id/rangeAsking"
                    android:layout_width="@dimen/range_pin_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="@drawable/bg_range_asking" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/askingLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Asking 4,500" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/verdictChip"
                    style="@style/Widget.RentRadar.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false"
                    tools:text="At market" />
            </LinearLayout>
        </LinearLayout>

        <!-- Principle 2: advisory, never accusatory. Describes the price,
             never the person who posted it. The divider lives inside the
             block so it disappears with it. -->
        <LinearLayout
            android:id="@+id/riskCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_width"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingTop="@dimen/space_20"
                android:paddingBottom="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_risk_heading"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/riskChip"
                        style="@style/Widget.RentRadar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:chipStrokeWidth="0dp"
                        app:ensureMinTouchTargetSize="false"
                        tools:text="Worth checking" />
                </LinearLayout>

                <TextView
                    android:id="@+id/riskReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="The asking price is 38 per cent below the usual range for this many bedrooms in East Legon." />

                <TextView
                    android:id="@+id/riskChecklistHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/result_risk_checklist_heading"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/riskChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:lineSpacingExtra="@dimen/space_4"
                    android:text="@string/result_risk_checklist"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecastCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_width"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingTop="@dimen/space_20"
                android:paddingBottom="@dimen/space_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_forecast_heading"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/forecastSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Asking prices in East Legon have been broadly flat over the past month." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forecastDetailButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/result_forecast_detail" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_width"
            android:background="?attr/colorOutlineVariant" />

        <!-- Principle 4: progressive disclosure. Not hidden, just not shouted. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailToggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/result_how_heading"
            app:cornerRadius="@dimen/shape_xs" />

        <LinearLayout
            android:id="@+id/detailPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingBottom="@dimen/space_8"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/detailBasis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Bedrooms, bathrooms, toilets, locality and listed amenities, compared with 2,529 Accra listings." />

            <TextView
                android:id="@+id/detailModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="price GH:PRICE:1.2.0" />

            <!-- Shown when the serving tier reports a stub artefact. -->
            <TextView
                android:id="@+id/detailStubWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/result_stub_warning"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>