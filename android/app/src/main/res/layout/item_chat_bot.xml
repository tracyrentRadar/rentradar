<?xml version="1.0" encoding="utf-8"?>
<!-- RentRadar speaks as plain text on the page. No bubble, no avatar.
     The person's own words are the only thing in a box, which is what
     makes the two sides readable at a glance. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bot_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:lineSpacingExtra="@dimen/space_4"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_8"
    android:textAppearance="?attr/textAppearanceBodyLarge"
    android:textColor="?attr/colorOnSurface"
    tools:text="Which area is the place in? You can type it or pick one below." />