<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Back on the left, how far through in the middle, a way out of a
         wrong turn on the right. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_app_bar"
        android:paddingHorizontal="@dimen/space_8">

        <ImageButton
            android:id="@+id/chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_back"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/chat_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_chat_pill"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_4"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3 of 7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_restart"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="@string/chat_restart"
            app:cornerRadius="@dimen/shape_xs" />
    </FrameLayout>

    <!-- The empty state. Logo, then a line that changes on every open.
         Hidden by ChatFragment once the first answer lands. -->
    <LinearLayout
        android:id="@+id/chat_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_8">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/chat_brand"
            android:src="@drawable/ic_brand_glyph"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/chat_greeting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_horizontal"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="What are we pricing?" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_horizontal"
            android:text="@string/chat_greeting_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        tools:listitem="@layout/item_chat_bot" />

    <!-- The tall card. Hint on its own line, controls underneath. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        android:background="@drawable/bg_chat_input"
        android:orientation="vertical"
        android:padding="@dimen/space_12">

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/chat_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="40dp"
            android:paddingHorizontal="@dimen/space_4"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/chat_options"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_options"
                android:padding="@dimen/space_8"
                android:src="@drawable/ic_options"
                app:tint="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/chat_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_send_circle"
                android:contentDescription="@string/chat_send"
                android:padding="@dimen/space_8"
                android:src="@drawable/ic_send_up"
                app:tint="?attr/colorOnPrimary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>