<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_primary"
    android:paddingStart="@dimen/space_24"
    android:paddingEnd="@dimen/space_24">

    <ImageView
        android:id="@+id/splash_mark"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_splash_mark"
        android:contentDescription="@string/app_name"
        android:padding="16dp"
        android:src="@drawable/ic_brand_glyph_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splash_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/splash_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="@color/md_on_primary"
        app:layout_constraintTop_toBottomOf="@id/splash_mark"
        app:layout_constraintBottom_toTopOf="@id/splash_tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:alpha="0.8"
        android:text="@string/splash_tagline"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/md_primary_container"
        app:layout_constraintTop_toBottomOf="@id/splash_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:alpha="0.6"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/md_primary_container"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/splash_tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/splash_rule"
        android:layout_width="64dp"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/space_16"
        android:alpha="0.4"
        android:background="@color/md_primary_container"
        app:layout_constraintBottom_toTopOf="@id/splash_institution"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/splash_institution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_32"
        android:alpha="0.7"
        android:text="@string/splash_institution"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/md_primary_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>