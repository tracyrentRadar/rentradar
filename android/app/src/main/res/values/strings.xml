    <!-- Chat intake, the script. Questions, acknowledgements and the confirm
     step. The locality, type and amenity choices come from arrays.xml. -->
    <string name="chat_intro">Tell me about the place and I will work out what it should cost. You can type it all in one go, or answer one question at a time.</string>
    <string name="chat_q_locality">Which area is it in? Type it, or pick one below.</string>
    <string name="chat_q_locality_retry">I do not know that area yet. Pick the closest one below, or type another.</string>
    <string name="chat_q_bedrooms">How many bedrooms?</string>
    <string name="chat_q_bathrooms">And how many bathrooms?</string>
    <string name="chat_q_count_retry">A number between 1 and 10, please.</string>
    <string name="chat_q_type">What kind of place is it?</string>
    <string name="chat_q_type_retry">I did not catch the type. Pick one below.</string>
    <string name="chat_q_amenities">What does it come with? Tick everything that applies, then tap Done. Or just tell me.</string>
    <string name="chat_q_amenities_retry">None of the usual ones in that. Tick what applies below, or say none.</string>
    <string name="chat_q_size">Roughly how big is it, in square metres? A guess is fine, or tap Not sure.</string>
    <string name="chat_q_size_retry">A number of square metres, please, or tap Not sure.</string>
    <string name="chat_q_rent">What are they asking per month, in cedis?</string>
    <string name="chat_q_rent_retry">I need a monthly figure in cedis, for example 4500 or 4.5k.</string>
    <string name="chat_ack">Got it: %1$s.</string>
    <string name="chat_confirm">Here is what I have.\n\n%1$s\n\nShall I get the estimate?</string>
    <string name="chat_confirm_retry">I did not catch that. Tap Get the estimate, or Change something.</string>
    <string name="chat_change_which">Which one should I change?</string>
    <string name="chat_chip_estimate">Get the estimate</string>
    <string name="chat_chip_change">Change something</string>
    <string name="chat_chip_done">Done</string>
    <string name="chat_chip_not_sure">Not sure</string>
    <string name="chat_size_assumed">I will use a typical size for %1$d bedrooms, about %2$d square metres. You can change it at the end.</string>
    <string name="chat_working">Working it out...</string>
    <string name="chat_done">Done. Come back here to change something and ask again.</string>
    <string name="chat_failed">That did not work: %1$s Tap Get the estimate to try again.</string>
