        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="scrimBackground">@color/md_scrim</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.RentRadar.DisplaySmall</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.RentRadar.DisplaySmall</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.RentRadar.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.RentRadar.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.RentRadar.HeadlineMedium</item>
