        <item name="materialButtonStyle">@style/Widget.RentRadar.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.RentRadar.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.RentRadar.Button.Text</item>
        <item name="textInputStyle">@style/Widget.RentRadar.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.RentRadar.CardView</item>
        <item name="chipStyle">@style/Widget.RentRadar.Chip</item>

        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>

    </style>

    <style name="Theme.RentRadar" parent="Base.Theme.RentRadar">
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>