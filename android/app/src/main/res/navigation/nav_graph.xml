<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!--
      Arguments are passed as plain Bundles, not Safe Args, because the Safe
      Args plugin is not applied to this project. ResultFragment.argsOf builds
      the Bundle, so the keys live in one place rather than being typed out at
      every call site.
    -->

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.rentradar.android.ui.splash.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.rentradar.android.ui.auth.LoginFragment"
        android:label="Sign in">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.rentradar.android.ui.auth.RegisterFragment"
        android:label="Create account">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.rentradar.android.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_input"
            app:destination="@id/propertyInputFragment" />
        <!-- Opening a past check from the recent list. -->
        <action
            android:id="@+id/action_home_to_result"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/propertyInputFragment"
        android:name="com.rentradar.android.ui.input.PropertyInputFragment"
        android:label="Check a rent">
        <!--
          No popUpTo. Back from the result returns to the filled-in form, so a
          user who mistyped a bedroom count fixes one field instead of retyping
          the whole thing.
        -->
        <action
            android:id="@+id/action_input_to_result"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.rentradar.android.ui.result.ResultFragment"
        android:label="Price check" />

</navigation>